#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&lt {
    tapping-term-ms = <200>;//lt的延迟时间
    flavor = "balanced";
    quick-tap-ms = <150>;//按下lt后，150ms内按住不松开，就一直是单击的这个按键，而不是切层的效果。150ms以内的这个时间是关键
};

/ {
    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <
&kp GRAVE         &kp N1        &kp N2        &kp N3     &kp N4  &kp N5  &kp N6    &kp N7  &kp N8     &kp N9         &kp N0         &kp BACKSPACE
&kp TAB           &kp Q         &kp W         &kp E      &kp R   &kp T   &kp Y     &kp U   &kp I      &kp O          &kp P          &mo 2
&kp CAPSLOCK      &kp A         &kp S         &kp D      &kp F   &kp G   &kp H     &kp J   &kp K      &kp L          &kp SEMI       &kp SQT
&kp LEFT_SHIFT    &kp Z         &kp X         &kp C      &kp V   &kp B   &kp N     &kp M   &kp COMMA  &kp DOT        &kp SLASH      &kp RIGHT_SHIFT
&kp LEFT_CONTROL  &kp LEFT_WIN  &kp LEFT_ALT  &kp ENTER  &mo 1   &mo 3   &mkp MB1  &mo 1   &kp SPACE  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp RCTRL
            >;

            sensor-bindings = <&inc_dec_kp LEFT RIGHT>, <&inc_dec_kp UP DOWN>;
        };

        VOLF {
            bindings = <
&kp ESC            &kp F1  &kp F2  &kp F3            &kp F4  &kp F5  &kp F6    &kp F7    &kp F8             &kp F9     &kp F10        &kp F11
&kp K_VOLUME_UP    &trans  &trans  &trans            &trans  &trans  &trans    &trans    &kp UP             &trans     &trans         &kp F12
&kp K_VOLUME_DOWN  &trans  &trans  &trans            &trans  &trans  &trans    &kp LEFT  &kp DOWN           &kp RIGHT  &trans         &trans
&trans             &trans  &trans  &trans            &trans  &trans  &trans    &trans    &trans             &trans     &kp BACKSLASH  &trans
&trans             &trans  &trans  &kp LEFT_BRACKET  &trans  &trans  &mkp MB2  &trans    &kp RIGHT_BRACKET  &trans     &trans         &trans
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_UP C_VOL_DN>,
                <&inc_dec_kp LC(Y) LC(Z)>;
        };

        BTRGB {
            bindings = <
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &rgb_ug RGB_HUI  &rgb_ug RGB_SAI  &rgb_ug RGB_BRI  &rgb_ug RGB_SPI  &rgb_ug RGB_EFF  &rgb_ug RGB_TOG
&trans       &trans        &trans        &trans        &trans        &trans        &rgb_ug RGB_HUD  &rgb_ug RGB_SAD  &rgb_ug RGB_BRD  &rgb_ug RGB_SPD  &rgb_ug RGB_EFR  &trans
&trans       &trans        &trans        &trans        &trans        &trans        &trans           &trans           &trans           &trans           &trans           &trans
&trans       &trans        &trans        &trans        &trans        &trans        &trans           &trans           &trans           &trans           &kp BACKSLASH    &trans
&bootloader  &trans        &trans        &kp MINUS     &trans        &trans        &mkp MB2         &trans           &kp EQUAL        &trans           &trans           &bootloader
            >;

            sensor-bindings = <&inc_dec_kp HOME END>, <&inc_dec_kp LC(Y) LC(Z)>;
        };

        scroll-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &mkp MB2  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LA(LEFT) LA(RIGHT)>,
                <&inc_dec_kp LC(Y) LC(Z)>;
        };

        snipe-layers {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
